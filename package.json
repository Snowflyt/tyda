{
  "name": "tyda",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "A composable type-level programming toolkit for TypeScript, with a focus on type-safe functional programming.",
  "keywords": [
    "type gymnastics",
    "type level",
    "type safe",
    "generic",
    "generic programming",
    "functional programming",
    "fp",
    "hkt",
    "higher kinded type",
    "type level programming"
  ],
  "homepage": "https://github.com/Snowflyt/tyda",
  "bugs": {
    "url": "https://github.com/Snowflyt/tyda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snowflyt/tyda.git"
  },
  "license": "MPL-2.0",
  "author": "Ge Gao (Snowflyt) <gaoge011022@gmail.com>",
  "type": "module",
  "types": "./index.d.ts",
  "workspaces": [
    "packages/*",
    "typroof-plugin"
  ],
  "scripts": {
    "format": "prettier --no-error-on-unmatched-pattern --write **/*.{js,ts,json,md} *.{cjs,mjs,cts,mts}",
    "postinstall": "node -e \"import fs from 'node:fs'; import path from 'node:path'; const hooksDir = path.join(process.cwd(), '.githooks'); const gitHooksDir = path.join(process.cwd(), '.git/hooks'); if (fs.existsSync(gitHooksDir)) { fs.readdirSync(hooksDir).forEach(file => { const srcFile = path.join(hooksDir, file); const destFile = path.join(gitHooksDir, file); fs.copyFileSync(srcFile, destFile); if (process.platform !== 'win32' && !file.endsWith('.cmd')) { fs.chmodSync(destFile, 0o755); } }); }\"",
    "lint": "eslint **/*.{js,ts} *.{cjs,mjs,cts,mts} --no-error-on-unmatched-pattern --report-unused-disable-directives-severity error --max-warnings 0",
    "lint:fix": "eslint --fix **/*.{js,ts} *.{cjs,mjs,cts,mts} --no-error-on-unmatched-pattern --report-unused-disable-directives-severity error --max-warnings 0",
    "test": "tsc --noEmit && typroof"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@typescript-eslint/parser": "^8.51.0",
    "cpy-cli": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "globals": "^16.5.0",
    "hkt-core": "^1.3.5",
    "json": "^11.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^2.5.20",
    "renamer": "^5.0.2",
    "replace-in-file": "^8.4.0",
    "rimraf": "^6.1.2",
    "typescript": "latest",
    "typescript-eslint": "^8.51.0",
    "typroof": "^0.6.0"
  }
}
